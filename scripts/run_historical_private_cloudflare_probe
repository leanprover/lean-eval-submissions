#!/usr/bin/env python3
"""Invoke one exact disposable Cloudflare private-image qualification Worker.

This client never accepts Cloudflare credentials.  It obtains a fresh GitHub
OIDC token for every request and writes only the closed source-free receipt.
The deployment and deletion steps live separately in the manual workflow.
"""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from typing import Any

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

from historical_private_image_qualification import (  # noqa: E402
    OIDC_AUDIENCE,
    RECEIPT_KIND,
    RUNNER_ENTRYPOINT,
    QualificationError,
    canonical,
    load_canonical,
    validate_candidate,
    write_exclusive,
)

DIGEST = re.compile(r"[0-9a-f]{64}\Z")
OCI_DIGEST = re.compile(r"sha256:[0-9a-f]{64}\Z")
CONTEXT_FIELDS = {
    "schema_version",
    "worker_name",
    "worker_url",
    "registry_manifest_digest",
    "benchmark_commit",
    "runner_nonce",
    "replay_task_id",
    "workflow_run_id",
    "workflow_run_attempt",
    "architecture",
    "kernel_release",
    "cpu_model",
}


def _object(value: Any, label: str) -> dict[str, Any]:
    if not isinstance(value, dict) or not all(isinstance(key, str) for key in value):
        raise QualificationError(f"{label} is invalid")
    return value


def _closed(value: dict[str, Any], fields: set[str], label: str) -> dict[str, Any]:
    if set(value) != fields:
        raise QualificationError(f"{label} fields are not closed")
    return value


def _load_inputs(
    candidate_path: pathlib.Path,
    request_path: pathlib.Path,
    status_path: pathlib.Path,
    context_path: pathlib.Path,
    manifest_digest: str,
) -> tuple[dict[str, Any], dict[str, Any], dict[str, Any], dict[str, Any]]:
    candidate, _ = load_canonical(candidate_path, "qualification candidate")
    request, _ = load_canonical(request_path, "qualification request")
    status, _ = load_canonical(status_path, "qualification status")
    context, _ = load_canonical(context_path, "qualification context")
    candidate = validate_candidate(candidate)
    _closed(context, CONTEXT_FIELDS, "qualification context")
    outer = _object(request, "qualification request")
    execution = _object(outer.get("request"), "execution request")
    if (
        context.get("schema_version") != 1
        or manifest_digest != context.get("registry_manifest_digest")
        or OCI_DIGEST.fullmatch(manifest_digest) is None
        or context.get("benchmark_commit") != candidate["benchmark_commit"]
        or context.get("runner_nonce") != outer.get("runner_nonce")
        or context.get("runner_nonce") != status.get("runner_nonce")
        or context.get("replay_task_id") != execution.get("replay_task_id")
        or context.get("replay_task_id") != status.get("replay_task_id")
        or not isinstance(context.get("worker_url"), str)
        or not context["worker_url"].startswith("https://lean-eval-private-q-")
        or not context["worker_url"].endswith(".lean-eval.workers.dev")
        or DIGEST.fullmatch(str(context.get("runner_nonce"))) is None
    ):
        raise QualificationError("qualification execution identity is inconsistent")
    return candidate, request, status, context


def _oidc_token() -> str:
    request_url = os.environ.get("ACTIONS_ID_TOKEN_REQUEST_URL", "")
    request_token = os.environ.get("ACTIONS_ID_TOKEN_REQUEST_TOKEN", "")
    if not request_url.startswith("https://") or not request_token:
        raise QualificationError("GitHub OIDC request authority is unavailable")
    parsed = urllib.parse.urlsplit(request_url)
    query = [
        item
        for item in urllib.parse.parse_qsl(parsed.query, keep_blank_values=True)
        if item[0] != "audience"
    ]
    query.append(("audience", OIDC_AUDIENCE))
    url = urllib.parse.urlunsplit(parsed._replace(query=urllib.parse.urlencode(query)))
    incoming = urllib.request.Request(
        url,
        headers={"authorization": f"Bearer {request_token}", "accept": "application/json"},
    )
    try:
        with urllib.request.urlopen(incoming, timeout=30) as response:
            body = json.load(response)
    except (OSError, urllib.error.HTTPError, json.JSONDecodeError) as error:
        raise QualificationError("GitHub OIDC token request failed") from error
    token = _object(body, "GitHub OIDC response").get("value")
    if not isinstance(token, str) or len(token) > 8192 or token.count(".") != 2:
        raise QualificationError("GitHub OIDC token response is invalid")
    return token


def _post(url: str, value: dict[str, Any]) -> tuple[int, dict[str, Any]]:
    incoming = urllib.request.Request(
        url,
        method="POST",
        data=canonical(value),
        headers={
            "authorization": f"Bearer {_oidc_token()}",
            "content-type": "application/json",
            "accept": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(incoming, timeout=60) as response:
            return response.status, _object(json.load(response), "executor response")
    except urllib.error.HTTPError as error:
        try:
            body = _object(json.load(error), "executor error response")
        except (QualificationError, json.JSONDecodeError) as parse_error:
            raise QualificationError("qualification executor returned a non-JSON error") from parse_error
        return error.code, body
    except (OSError, json.JSONDecodeError) as error:
        raise QualificationError("qualification executor request failed") from error


def _health(worker_url: str, expected_commit: str) -> None:
    try:
        incoming = urllib.request.Request(
            f"{worker_url}/healthz", headers={"accept": "application/json"}
        )
        with urllib.request.urlopen(incoming, timeout=30) as response:
            body = _object(json.load(response), "executor health")
    except (OSError, urllib.error.HTTPError, json.JSONDecodeError) as error:
        raise QualificationError("qualification executor health check failed") from error
    if (
        body.get("status") != "ok"
        or body.get("environment") != "private-qualification"
        or body.get("deployed_commit") != expected_commit
        or body.get("replay_enabled") is not True
    ):
        raise QualificationError("qualification executor health identity is invalid")


def _cleanup(worker_url: str, status_request: dict[str, Any]) -> None:
    code, body = _post(
        f"{worker_url}/api/v1/private-qualification/cleanup", status_request
    )
    if (
        code != 200
        or set(body) != {"schema_version", "replay_task_id", "attempt", "destruction"}
        or body.get("schema_version") != 1
        or body.get("replay_task_id") != status_request.get("replay_task_id")
        or body.get("attempt") != status_request.get("attempt")
        or body.get("destruction") != "confirmed"
    ):
        raise QualificationError("sandbox cleanup was not confirmed")


def _run(
    candidate: dict[str, Any],
    request: dict[str, Any],
    status_request: dict[str, Any],
    context: dict[str, Any],
    output: pathlib.Path,
    reservation_marker: pathlib.Path,
) -> None:
    worker_url = context["worker_url"]
    _health(worker_url, candidate["image_source_commit"])
    reserve_code, reservation = _post(
        f"{worker_url}/api/v1/private-qualification/reserve", status_request
    )
    if (
        reserve_code != 200
        or set(reservation)
        != {"schema_version", "replay_task_id", "attempt", "status"}
        or reservation.get("schema_version") != 1
        or reservation.get("replay_task_id") != context["replay_task_id"]
        or reservation.get("attempt") != 1
        or reservation.get("status") != "reserved"
    ):
        raise QualificationError("sandbox cleanup identity was not reserved")
    write_exclusive(reservation_marker, {
        "schema_version": 1,
        "runner_nonce": context["runner_nonce"],
        "replay_task_id": context["replay_task_id"],
        "status": "reserved",
    })
    code, started = _post(f"{worker_url}/api/v1/replay", request)
    if code != 202 or started.get("status") != "running":
        raise QualificationError("qualification executor did not start the reviewed probe")
    deadline = time.monotonic() + 20_400
    while True:
        code, body = _post(f"{worker_url}/api/v1/replay/status", status_request)
        if code == 202 and body.get("status") == "running":
            if time.monotonic() >= deadline:
                raise QualificationError("qualification executor exceeded its deadline")
            time.sleep(20)
            continue
        break
    if code != 200 or set(body) != {"schema_version", "verdict", "destruction"}:
        raise QualificationError("qualification executor did not return one terminal verdict")
    verdict = _object(body.get("verdict"), "qualification verdict")
    if (
        body.get("schema_version") != 1
        or body.get("destruction") != "confirmed"
        or verdict.get("schema_version") != 1
        or verdict.get("replay_task_id") != context["replay_task_id"]
        or verdict.get("attempt") != 1
        or verdict.get("execution_outcome") != "completed"
        or verdict.get("checker_outcome") not in {"accepted", "rejected", "declined"}
        or verdict.get("failure_reason") is not None
    ):
        raise QualificationError("qualification verdict is not a passing official-entrypoint probe")
    receipt = {
        "schema_version": 1,
        "kind": RECEIPT_KIND,
        "registry_manifest_digest": context["registry_manifest_digest"],
        "benchmark_commit": context["benchmark_commit"],
        "runner_entrypoint": RUNNER_ENTRYPOINT,
        "archive_expectation_schema_version": 2,
        "key_material_type": "age-file-key-v1",
        "network_probe": "blocked",
        "status": "passed",
        "architecture": context["architecture"],
        "kernel_release": context["kernel_release"],
        "cpu_model": context["cpu_model"],
    }
    write_exclusive(output, receipt)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--candidate", required=True, type=pathlib.Path)
    parser.add_argument("--request", required=True, type=pathlib.Path)
    parser.add_argument("--status", required=True, type=pathlib.Path)
    parser.add_argument("--context", required=True, type=pathlib.Path)
    parser.add_argument("--registry-manifest-digest", required=True)
    parser.add_argument("--output", type=pathlib.Path)
    parser.add_argument("--reservation-marker", type=pathlib.Path)
    parser.add_argument("--cleanup-only", action="store_true")
    args = parser.parse_args()
    try:
        candidate, request, status, context = _load_inputs(
            args.candidate,
            args.request,
            args.status,
            args.context,
            args.registry_manifest_digest,
        )
        if args.cleanup_only:
            if args.output is not None or args.reservation_marker is not None:
                raise QualificationError("cleanup-only mode does not accept outputs")
            _cleanup(context["worker_url"], status)
        else:
            if args.output is None or args.reservation_marker is None:
                raise QualificationError("probe mode requires receipt and reservation outputs")
            _run(
                candidate, request, status, context, args.output, args.reservation_marker
            )
    except (OSError, QualificationError, ValueError) as error:
        print(f"historical-private-cloudflare-probe: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
