{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lean-eval-submission",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "lean-eval-submission-server-staging",
      "secrets": {
        "required": [
          "AUTH_TOKEN_SECRET",
          "GITHUB_OAUTH_CLIENT_ID",
          "GITHUB_OAUTH_CLIENT_SECRET",
          "GITHUB_STATE_TOKEN",
          "LIFECYCLE_CALLBACK_TOKEN",
          "READINESS_TOKEN"
        ]
      },
      "workers_dev": true,
      "preview_urls": false,
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "24012001",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "services": [
        {
          "binding": "GITHUB_BROKER",
          "service": "lean-eval-github-broker-staging"
        }
      ],
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "DEPLOYED_COMMIT": "development",
        "DEPLOYMENT_ENVIRONMENT": "staging",
        "INTAKE_ENABLED": "false",
        "INTAKE_ENABLEMENT_MODE": "disabled",
        "PROMOTION_CANARY_ENABLED": "true",
        "LEGACY_RESULT_OWNER_API_ENABLED": "false",
        "RESULT_OWNER_STATE_CONTRACT_COMMIT": "4b8dcdf0a3d03749f51bef23807eeb1d00c43b72",
        "BROWSER_SUCCESS_URL": "/",
        "DISPATCH_REPOSITORY": "leanprover/lean-eval-submissions",
        "DISPATCH_WORKFLOW": "submission.yml",
        "OAUTH_CALLBACK_URL": "https://lean-eval-submission-server-staging.lean-eval.workers.dev/api/v1/oauth/callback",
        "STATE_REPOSITORY": "leanprover/lean-eval-state-staging"
      }
    },
    "production": {
      "name": "lean-eval-submission-server",
      "secrets": {
        "required": [
          "AUTH_TOKEN_SECRET",
          "GITHUB_OAUTH_CLIENT_ID",
          "GITHUB_OAUTH_CLIENT_SECRET",
          "GITHUB_STATE_TOKEN",
          "LIFECYCLE_CALLBACK_TOKEN",
          "READINESS_TOKEN"
        ]
      },
      "workers_dev": true,
      "preview_urls": false,
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "24012002",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "services": [
        {
          "binding": "GITHUB_BROKER",
          "service": "lean-eval-github-broker-production"
        }
      ],
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "DEPLOYED_COMMIT": "development",
        "DEPLOYMENT_ENVIRONMENT": "production",
        "INTAKE_ENABLED": "false",
        "INTAKE_ENABLEMENT_MODE": "disabled",
        "PROMOTION_CANARY_ENABLED": "false",
        "LEGACY_RESULT_OWNER_API_ENABLED": "false",
        "RESULT_OWNER_STATE_CONTRACT_COMMIT": "4b8dcdf0a3d03749f51bef23807eeb1d00c43b72",
        "BROWSER_SUCCESS_URL": "/",
        "DISPATCH_REPOSITORY": "leanprover/lean-eval-submissions",
        "DISPATCH_WORKFLOW": "submission.yml",
        "OAUTH_CALLBACK_URL": "https://lean-eval-submission-server.lean-eval.workers.dev/api/v1/oauth/callback",
        "STATE_REPOSITORY": "leanprover/lean-eval-state"
      }
    }
  }
}
