#!/usr/bin/env python3
from __future__ import annotations

import base64
import hashlib
import json
import os
import pathlib
import subprocess
import sys
import tarfile

WORKSPACE = pathlib.Path("/workspace")
MAX_CIPHERTEXT = 128 * 1024
MAX_PLAINTEXT = 128 * 1024


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def load_json(path: pathlib.Path) -> dict[str, object]:
    try:
        raw = path.read_bytes()
        if len(raw) > 4096:
            fail("expectation exceeds size limit")
        value = json.loads(raw.decode("utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        fail("expectation is invalid")
    if not isinstance(value, dict):
        fail("expectation is invalid")
    return value


def decode_file(source: pathlib.Path, destination: pathlib.Path, maximum: int) -> None:
    try:
        encoded = source.read_bytes()
        decoded = base64.b64decode(encoded, validate=True)
    except (OSError, ValueError):
        fail("encoded input is invalid")
    if not decoded or len(decoded) > maximum:
        fail("decoded input exceeds size limit")
    descriptor = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, "wb") as output:
        output.write(decoded)


def sha256(path: pathlib.Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(65536), b""):
            digest.update(chunk)
    return digest.hexdigest()


def marker_digest(path: pathlib.Path) -> str:
    try:
        with tarfile.open(path, "r:gz") as archive:
            members = archive.getmembers()
            if len(members) != 1 or members[0].name != "marker.bin" or not members[0].isfile():
                fail("decrypted archive has unexpected entries")
            marker_file = archive.extractfile(members[0])
            if marker_file is None:
                fail("decrypted marker is unavailable")
            marker = marker_file.read(65)
    except (OSError, tarfile.TarError):
        fail("decrypted archive is invalid")
    if len(marker) != 64:
        fail("decrypted marker has unexpected size")
    return hashlib.sha256(marker).hexdigest()


def main() -> None:
    os.umask(0o077)
    expectation = load_json(WORKSPACE / "expectation.json")
    if set(expectation) != {"schema_version", "archive_ciphertext_sha256", "marker_sha256"}:
        fail("expectation fields are invalid")
    if expectation["schema_version"] != 1:
        fail("expectation schema is invalid")
    ciphertext = WORKSPACE / "archive.tar.gz.age"
    identity = WORKSPACE / "identity.age"
    plaintext = WORKSPACE / "source.tar.gz"
    decode_file(WORKSPACE / "archive.tar.gz.age.b64", ciphertext, MAX_CIPHERTEXT)
    decode_file(WORKSPACE / "identity.age.b64", identity, 4096)
    if sha256(ciphertext) != expectation["archive_ciphertext_sha256"]:
        fail("ciphertext digest mismatch")
    decrypt = subprocess.run(
        ["age", "--decrypt", "--identity", str(identity), "--output", str(plaintext), str(ciphertext)],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env={"PATH": "/usr/local/bin:/usr/bin:/bin"},
    )
    identity.unlink(missing_ok=True)
    if decrypt.returncode != 0 or not plaintext.is_file() or plaintext.stat().st_size > MAX_PLAINTEXT:
        fail("archive decryption failed")
    actual_marker = marker_digest(plaintext)
    plaintext.unlink(missing_ok=True)
    if actual_marker != expectation["marker_sha256"]:
        fail("marker digest mismatch")
    network = subprocess.run(
        ["curl", "--fail", "--silent", "--show-error", "--max-time", "5", "https://example.com/"],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env={"PATH": "/usr/local/bin:/usr/bin:/bin"},
    )
    if network.returncode == 0:
        fail("network isolation failed")
    cpu_model = "unavailable"
    try:
        for line in pathlib.Path("/proc/cpuinfo").read_text(encoding="utf-8").splitlines():
            if line.lower().startswith("model name") and ":" in line:
                cpu_model = line.split(":", 1)[1].strip()[:256] or "unavailable"
                break
    except OSError:
        pass
    print(json.dumps({
        "schema_version": 1,
        "archive_ciphertext_sha256": expectation["archive_ciphertext_sha256"],
        "marker_sha256": actual_marker,
        "network_probe": "blocked",
        "architecture": os.uname().machine[:128],
        "kernel_release": os.uname().release[:256],
        "cpu_model": cpu_model,
    }, separators=(",", ":"), sort_keys=True))


if __name__ == "__main__":
    main()
