#!/usr/bin/python3 -I
"""Inactive trusted namespace agent; installed only by a future qualified image."""
import runpy
import sys

try:
    if len(sys.argv) != 3:
        raise ValueError()
    module = runpy.run_path('/opt/lean-eval/stock_replay_supervisor.py')
    raise SystemExit(module['agent'](int(sys.argv[1]), int(sys.argv[2])))
except Exception:
    raise SystemExit(125) from None
