#!/usr/bin/python3 -I
"""Inactive stock-image entry point; trusted files must be baked at fixed paths."""
import os
import runpy
import ctypes
import signal
import sys

if signal.getsignal(signal.SIGINT) is signal.default_int_handler:
    signal.signal(signal.SIGINT, signal.SIG_DFL)
parent = os.getppid()
if parent == 1:
    os.kill(os.getpid(), signal.SIGKILL)
try:
    guarded = ctypes.CDLL(None, use_errno=True).prctl(1, signal.SIGKILL, 0, 0, 0) == 0
except Exception:
    guarded = False
if os.getppid() != parent:
    os.kill(os.getpid(), signal.SIGKILL)
if not guarded:
    os.execv('/usr/bin/bwrap', ['/usr/bin/bwrap', *sys.argv[1:]])
try:
    module = runpy.run_path('/opt/lean-eval/stock_replay_measurement.py')
except Exception:
    os.execv('/usr/bin/bwrap', ['/usr/bin/bwrap', *sys.argv[1:]])
raise SystemExit(module['main'](sys.argv[1:]))
