#!/usr/bin/env python3
from __future__ import annotations

import base64
import hashlib
import json
import os
import pathlib
import subprocess
import sys
import tarfile

WORKSPACE = pathlib.Path("/workspace")
MAX_CIPHERTEXT = 11 * 1024 * 1024
MAX_PLAINTEXT = 10 * 1024 * 1024
MAX_EXPANDED = 50 * 1024 * 1024
MAX_MEMBERS = 4096


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def load_expectation() -> dict[str, object]:
    path = WORKSPACE / "archive-expectation.json"
    try:
        raw = path.read_bytes()
        value = json.loads(raw.decode("utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        fail("expectation is invalid")
    fields = {
        "schema_version",
        "submission_id",
        "archive_ciphertext_sha256",
        "plaintext_tar_sha256",
        "plaintext_tar_size",
    }
    if not isinstance(value, dict) or set(value) != fields or len(raw) > 4096:
        fail("expectation fields are invalid")
    if value["schema_version"] != 1:
        fail("expectation schema is invalid")
    return value


def decode_file(source: pathlib.Path, destination: pathlib.Path, maximum: int) -> None:
    try:
        decoded = base64.b64decode(source.read_bytes(), validate=True)
    except (OSError, ValueError):
        fail("encoded input is invalid")
    if not decoded or len(decoded) > maximum:
        fail("decoded input exceeds size limit")
    descriptor = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, "wb") as output:
        output.write(decoded)


def sha256(path: pathlib.Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def validate_tar(path: pathlib.Path) -> None:
    try:
        with tarfile.open(path, "r:gz") as archive:
            members = archive.getmembers()
    except (OSError, tarfile.TarError):
        fail("decrypted archive is invalid")
    if not members or len(members) > MAX_MEMBERS:
        fail("decrypted archive member count is invalid")
    expanded = 0
    for member in members:
        candidate = pathlib.PurePosixPath(member.name)
        if (
            candidate.is_absolute()
            or not candidate.parts
            or candidate.parts[0] != "source"
            or any(part in {"", ".", ".."} for part in candidate.parts)
            or not (member.isfile() or member.isdir())
        ):
            fail("decrypted archive contains an unsafe member")
        if member.isfile():
            expanded += member.size
            if expanded > MAX_EXPANDED:
                fail("decrypted archive expands beyond its limit")


def platform_evidence() -> tuple[str, str, str]:
    cpu_model = "unavailable"
    try:
        for line in pathlib.Path("/proc/cpuinfo").read_text(encoding="utf-8").splitlines():
            if line.lower().startswith("model name") and ":" in line:
                cpu_model = line.split(":", 1)[1].strip()[:256] or "unavailable"
                break
    except OSError:
        pass
    return os.uname().machine[:128], os.uname().release[:256], cpu_model


def main() -> None:
    os.umask(0o077)
    expectation = load_expectation()
    ciphertext = WORKSPACE / "accepted-source.tar.gz.age"
    identity = WORKSPACE / "accepted-source.identity.age"
    plaintext = WORKSPACE / "accepted-source.tar.gz"
    decode_file(WORKSPACE / "archive.tar.gz.age.b64", ciphertext, MAX_CIPHERTEXT)
    decode_file(WORKSPACE / "identity.age.b64", identity, 4096)
    if sha256(ciphertext) != expectation["archive_ciphertext_sha256"]:
        fail("ciphertext digest mismatch")
    decrypt = subprocess.run(
        ["age", "--decrypt", "--identity", str(identity), "--output", str(plaintext), str(ciphertext)],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env={"PATH": "/usr/local/bin:/usr/bin:/bin"},
    )
    identity.unlink(missing_ok=True)
    if decrypt.returncode != 0 or not plaintext.is_file():
        fail("archive decryption failed")
    if plaintext.stat().st_size != expectation["plaintext_tar_size"]:
        fail("plaintext size mismatch")
    if plaintext.stat().st_size > MAX_PLAINTEXT or sha256(plaintext) != expectation["plaintext_tar_sha256"]:
        fail("plaintext digest mismatch")
    validate_tar(plaintext)
    plaintext.unlink(missing_ok=True)
    network = subprocess.run(
        ["curl", "--fail", "--silent", "--show-error", "--max-time", "5", "https://example.com/"],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env={"PATH": "/usr/local/bin:/usr/bin:/bin"},
    )
    if network.returncode == 0:
        fail("network isolation failed")
    architecture, kernel_release, cpu_model = platform_evidence()
    print(json.dumps({
        "schema_version": 1,
        "submission_id": expectation["submission_id"],
        "archive_ciphertext_sha256": expectation["archive_ciphertext_sha256"],
        "plaintext_tar_sha256": expectation["plaintext_tar_sha256"],
        "plaintext_tar_size": expectation["plaintext_tar_size"],
        "network_probe": "blocked",
        "architecture": architecture,
        "kernel_release": kernel_release,
        "cpu_model": cpu_model,
    }, separators=(",", ":"), sort_keys=True))


if __name__ == "__main__":
    main()
