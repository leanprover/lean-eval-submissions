{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lean-eval-replay-executor",
  "main": "src/replay-entry.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "lean-eval-replay-executor-staging",
      "workers_dev": true,
      "preview_urls": false,
      "containers": [
        {
          "class_name": "ReplaySandbox",
          "image": "registry.cloudflare.com/a46b90978a1c29cc4795f30677e7e4b8/lean-eval-authoritative:4026b18d5e679b07be1961d538a51ad689a9d8d4",
          "instance_type": "standard-4",
          "max_instances": 1,
          "ssh": { "enabled": false }
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "REPLAY_SANDBOX", "class_name": "ReplaySandbox" },
          { "name": "REPLAY_TERMINAL_RECEIPT", "class_name": "ReplayTerminalReceipt" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["ReplaySandbox"] },
        { "tag": "v2", "new_sqlite_classes": ["ReplayTerminalReceipt"] }
      ],
      "vars": {
        "DEPLOYED_COMMIT": "development",
        "DEPLOYMENT_ENVIRONMENT": "staging",
        "REPLAY_ENABLED": "true",
        "STAGING_ACCEPTANCE_ENABLED": "true",
        "GITHUB_OIDC_AUDIENCE": "lean-eval-replay-staging",
        "GITHUB_OIDC_ENVIRONMENT": "replay-staging",
        "STAGING_MEMORY_LIMIT_BYTES": "12884901888",
        "PRODUCTION_MEMORY_GATE_BYTES": "12884901888",
        "REVIEWED_EXECUTION_PROFILE_DIGEST": "fabd804359adbe7737e1db206d1877d3b923385cf2e8e95ec2b3be69a0d4c651",
        "REVIEWED_MEASUREMENT_CONFIG_DIGEST": "2dfc898270b83b6c99689e3f551a102c5e76636ec9f469a408498080e3e45945",
        "REVIEWED_VM_IMAGE_DIGEST": "sha256:f61b6be446c3bc355c2eefddc3b376226acee89ca562e66f3b283576a32bb20b",
        "SANDBOX_TRANSPORT": "rpc"
      }
    },
    "production": {
      "name": "lean-eval-replay-executor",
      "workers_dev": true,
      "preview_urls": false,
      "containers": [
        {
          "class_name": "ReplaySandbox",
          "image": "registry.cloudflare.com/a46b90978a1c29cc4795f30677e7e4b8/lean-eval-authoritative:4026b18d5e679b07be1961d538a51ad689a9d8d4",
          "instance_type": "standard-4",
          "max_instances": 1,
          "ssh": { "enabled": false }
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "REPLAY_SANDBOX", "class_name": "ReplaySandbox" },
          { "name": "REPLAY_TERMINAL_RECEIPT", "class_name": "ReplayTerminalReceipt" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["ReplaySandbox"] },
        { "tag": "v2", "new_sqlite_classes": ["ReplayTerminalReceipt"] }
      ],
      "vars": {
        "DEPLOYED_COMMIT": "development",
        "DEPLOYMENT_ENVIRONMENT": "production",
        "REPLAY_ENABLED": "false",
        "STAGING_ACCEPTANCE_ENABLED": "false",
        "GITHUB_OIDC_AUDIENCE": "lean-eval-replay-production",
        "GITHUB_OIDC_ENVIRONMENT": "replay-production",
        "STAGING_MEMORY_LIMIT_BYTES": "12884901888",
        "PRODUCTION_MEMORY_GATE_BYTES": "12884901888",
        "REVIEWED_EXECUTION_PROFILE_DIGEST": "fabd804359adbe7737e1db206d1877d3b923385cf2e8e95ec2b3be69a0d4c651",
        "REVIEWED_MEASUREMENT_CONFIG_DIGEST": "2dfc898270b83b6c99689e3f551a102c5e76636ec9f469a408498080e3e45945",
        "REVIEWED_VM_IMAGE_DIGEST": "sha256:f61b6be446c3bc355c2eefddc3b376226acee89ca562e66f3b283576a32bb20b",
        "SANDBOX_TRANSPORT": "rpc"
      }
    }
  }
}
