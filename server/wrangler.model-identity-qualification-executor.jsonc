{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lean-eval-model-identity-qualification-executor",
  "main": "src/model-identity-qualification-executor.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "lean-eval-model-identity-qualification-executor-staging",
      "workers_dev": false,
      "preview_urls": false,
      "limits": { "subrequests": 400 },
      "secrets": {
        "required": [
          "AUTH_TOKEN_SECRET",
          "GITHUB_STATE_TOKEN",
          "MODEL_IDENTITY_QUALIFICATION_EXECUTOR_SECRET"
        ]
      },
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "24012003",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "vars": {
        "DEPLOYED_COMMIT": "0000000000000000000000000000000000000000",
        "DEPLOYMENT_ENVIRONMENT": "staging",
        "MODEL_IDENTITY_STATE_CONTRACT_COMMIT": "9fc7c431a92c678554c65ebac68d3fddf4990d29",
        "STATE_REPOSITORY": "leanprover/lean-eval-state-staging"
      }
    }
  }
}
