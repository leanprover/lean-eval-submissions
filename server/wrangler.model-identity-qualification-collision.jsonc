{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lean-eval-model-identity-qualification-collision",
  "main": "src/model-identity-qualification-collision.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "lean-eval-model-identity-qualification-collision-staging",
      "workers_dev": false,
      "preview_urls": false,
      "limits": { "subrequests": 400 },
      "secrets": {
        "required": [
          "GITHUB_STATE_TOKEN",
          "MODEL_IDENTITY_QUALIFICATION_EXECUTOR_SECRET"
        ]
      },
      "vars": {
        "DEPLOYED_COMMIT": "0000000000000000000000000000000000000000",
        "DEPLOYMENT_ENVIRONMENT": "staging",
        "STATE_REPOSITORY": "leanprover/lean-eval-state-staging"
      }
    }
  }
}
