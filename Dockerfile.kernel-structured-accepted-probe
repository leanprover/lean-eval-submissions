ARG BASE_IMAGE
FROM docker.io/rust:1.95.0-bookworm@sha256:6258907abe69656e41cd992e0b705cdcfabcbbe3db374f92ed2d47121282d4a1 AS structured-kernel-builder

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# This source is the provisional head of upstream Mathgraph PR #51. The manual
# workflow refuses execution while the committed fixture has that status.
# After upstream merge, this URL and the fixture status must both be updated.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && test "$(rustc --version)" = 'rustc 1.95.0 (59807616e 2026-04-14)' \
    && git init /build/mathgraph \
    && git -C /build/mathgraph remote add origin https://github.com/kim-em/mathgraph-lean-kernel.git \
    && git -C /build/mathgraph fetch --depth 1 origin 400ab9c1cc4fba03f7a3f95f4604b5cef4e23a44 \
    && git -C /build/mathgraph checkout --detach FETCH_HEAD \
    && test "$(git -C /build/mathgraph rev-parse HEAD)" = 400ab9c1cc4fba03f7a3f95f4604b5cef4e23a44 \
    && test "$(git -C /build/mathgraph rev-parse 'HEAD^{tree}')" = 05ebd1a6a4bba6d38729e51f38680186288f4ac3 \
    && test "$(sha256sum /build/mathgraph/protocol/sokonanoda-result-v1.schema.json | cut -d' ' -f1)" = b96b99526a143ae39a9e8d058f80337f34d3e7c153e9e1878d2c29d9a56767d9 \
    && test "$(sha256sum /build/mathgraph/protocol/sokonanoda-result-v1-vectors.json | cut -d' ' -f1)" = 0712d67d88c65f10742ede70d0697360a0fc22b5ff79197f19050ae5e2812f4d \
    && cargo build --locked --release --manifest-path /build/mathgraph/Cargo.toml \
    && strip /build/mathgraph/target/release/sokonanoda \
    && sha256sum /build/mathgraph/target/release/sokonanoda \
      | cut -d' ' -f1 > /build/mathgraph/target/release/sokonanoda.sha256

FROM ${BASE_IMAGE}

COPY --from=structured-kernel-builder /build/mathgraph/target/release/sokonanoda /opt/lean-eval/bin/sokonanoda
COPY --from=structured-kernel-builder /build/mathgraph/target/release/sokonanoda.sha256 /opt/lean-eval/bin/sokonanoda.sha256
COPY scripts/kernel_corpus_report.py /opt/lean-eval/kernel_corpus_report.py
COPY scripts/kernel_runner_wire_contract.py /opt/lean-eval/kernel_runner_wire_contract.py
COPY scripts/kernel_structured_accepted_probe.py /opt/lean-eval/kernel_structured_accepted_probe.py
COPY tests/fixtures/kernel-structured-accepted-probe-v1.json /opt/lean-eval/kernel-structured-accepted-probe-v1.json
COPY server/replay-image/kernel-structured-accepted-probe /opt/lean-eval/kernel-structured-accepted-probe

RUN chmod 0555 /opt/lean-eval/bin/sokonanoda \
      /opt/lean-eval/kernel-structured-accepted-probe \
    && chmod 0444 /opt/lean-eval/bin/sokonanoda.sha256 \
    && python3 -c 'import hashlib, pathlib; binary = pathlib.Path("/opt/lean-eval/bin/sokonanoda"); expected = pathlib.Path("/opt/lean-eval/bin/sokonanoda.sha256").read_text().strip(); assert hashlib.sha256(binary.read_bytes()).hexdigest() == expected' \
    && python3 -c 'import sys; sys.path.insert(0, "/opt/lean-eval"); from kernel_structured_accepted_probe import execute_probe; assert callable(execute_probe)'
