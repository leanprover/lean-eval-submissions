{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanprover.github.io/lean-eval-submissions/schemas/kernel-solution-export-input-v1.schema.json",
  "title": "Source-free solution-export input metadata version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "result_id", "replay_task_id", "replay_attempt", "input_sha256", "input_size_bytes", "encoding", "format_version", "source_free", "exporter", "comparison_framework", "lean", "benchmark_configuration", "terminal_evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "kernel_solution_export_input"},
    "result_id": {"type": "string", "pattern": "^r2_[0-9a-f]{64}$"},
    "replay_task_id": {"type": "string", "pattern": "^rt1_[0-9a-f]{64}$"},
    "replay_attempt": {"$ref": "#/$defs/positive_integer"},
    "input_sha256": {"$ref": "#/$defs/digest"},
    "input_size_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
    "encoding": {"const": "utf8_ndjson"},
    "format_version": {"const": "3.1.0"},
    "source_free": {"const": true},
    "exporter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "binary_sha256", "name", "version", "format_specification_sha256", "format_specification_path"],
      "properties": {
        "repository": {"const": "leanprover/lean4export"},
        "commit": {"$ref": "#/$defs/commit"},
        "binary_sha256": {"$ref": "#/$defs/digest"},
        "name": {"const": "lean4export"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "format_specification_sha256": {"const": "f82a21e17e4258a1043895d0653ea4333bef8cb07aad2e3d6c1fc4be52b138e3"},
        "format_specification_path": {"const": "format_ndjson.md"}
      }
    },
    "comparison_framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "protocol"],
      "properties": {
        "repository": {"const": "leanprover/comparator"},
        "commit": {"$ref": "#/$defs/commit"},
        "protocol": {"const": "external_kernels_v1"}
      }
    },
    "benchmark_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "problem_id", "statement_revision", "path", "blob_sha256", "permitted_axioms"],
      "properties": {
        "repository": {"const": "leanprover/lean-eval"},
        "commit": {"$ref": "#/$defs/commit"},
        "problem_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
        "statement_revision": {"$ref": "#/$defs/positive_integer"},
        "path": {"type": "string", "pattern": "^generated/[A-Za-z0-9][A-Za-z0-9_-]{0,127}/config\\.json$"},
        "blob_sha256": {"$ref": "#/$defs/digest"},
        "permitted_axioms": {"$ref": "#/$defs/axioms"}
      }
    },
    "lean": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolchain", "version", "githash"],
      "properties": {
        "toolchain": {"type": "string", "pattern": "^leanprover/lean4:v[0-9]+\\.[0-9]+\\.[0-9]+(?:-(?:rc|beta)[0-9]+)?$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "githash": {"$ref": "#/$defs/commit"}
      }
    },
    "terminal_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_verdict_sha256", "terminal_event_sha256", "report_entry_sha256"],
      "properties": {
        "terminal_verdict_sha256": {"$ref": "#/$defs/digest"},
        "terminal_event_sha256": {"$ref": "#/$defs/digest"},
        "report_entry_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "positive_integer": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "axioms": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_']*(?:\\.[A-Za-z_][A-Za-z0-9_']*)*$"}}
  }
}
