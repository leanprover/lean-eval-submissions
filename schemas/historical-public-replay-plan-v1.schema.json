{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanprover.github.io/lean-eval-submissions/schemas/historical-public-replay-plan-v1.schema.json",
  "title": "Historical public replay source-free seed plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "source_repository", "source_commit",
    "inventory_sha256", "resolution_requests_sha256",
    "github_evidence_aggregate_sha256", "workflow_definition_registry_sha256",
    "benchmark_toolchain_registry_sha256", "resolved_request_count",
    "resolved_result_count", "pending_request_count", "activation_status",
    "activation_requirement", "requests"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "historical_public_replay_plan"},
    "source_repository": {"const": "leanprover/lean-eval-submissions"},
    "source_commit": {"$ref": "#/$defs/commit"},
    "inventory_sha256": {"$ref": "#/$defs/digest"},
    "resolution_requests_sha256": {"$ref": "#/$defs/digest"},
    "github_evidence_aggregate_sha256": {"$ref": "#/$defs/digest"},
    "workflow_definition_registry_sha256": {"$ref": "#/$defs/digest"},
    "benchmark_toolchain_registry_sha256": {"$ref": "#/$defs/digest"},
    "resolved_request_count": {"type": "integer", "minimum": 1},
    "resolved_result_count": {"type": "integer", "minimum": 1},
    "pending_request_count": {"type": "integer", "minimum": 0},
    "activation_status": {"const": "blocked"},
    "activation_requirement": {"const": "legacy_public_result_replay_authority_v1"},
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/request"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "resultId": {"type": "string", "pattern": "^r2_[0-9a-f]{64}$"},
    "requestId": {"type": "string", "pattern": "^prr_[0-9a-f]{64}$"},
    "problem": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "toolchain": {
      "type": "string",
      "pattern": "^leanprover/lean4:v[0-9]+\\.[0-9]+\\.[0-9]+(?:-(?:rc|beta)[0-9]+)?$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "commit", "visibility"],
      "properties": {
        "kind": {"enum": ["github_repo", "gist"]},
        "repository": {"$ref": "#/$defs/repository"},
        "commit": {"$ref": "#/$defs/commit"},
        "visibility": {"const": "public"}
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "toolchain", "lean_toolchain_blob_sha256"],
      "properties": {
        "repository": {"const": "leanprover/lean-eval"},
        "commit": {"$ref": "#/$defs/commit"},
        "toolchain": {"$ref": "#/$defs/toolchain"},
        "lean_toolchain_blob_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id", "owner", "problem_id", "statement_revision",
        "results_repository", "results_commit", "results_path",
        "result_file_sha256", "result_tree_digest"
      ],
      "properties": {
        "result_id": {"$ref": "#/$defs/resultId"},
        "owner": {"type": "string", "minLength": 1, "maxLength": 39},
        "problem_id": {"$ref": "#/$defs/problem"},
        "statement_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "results_repository": {"const": "leanprover/lean-eval-submissions"},
        "results_commit": {"$ref": "#/$defs/commit"},
        "results_path": {
          "type": "string",
          "pattern": "^results/[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?\\.json$"
        },
        "result_file_sha256": {"$ref": "#/$defs/digest"},
        "result_tree_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id", "accepted_at", "owner", "declared_model", "issue",
        "historical_evaluation", "source", "benchmark", "results",
        "activation_requirement"
      ],
      "properties": {
        "request_id": {"$ref": "#/$defs/requestId"},
        "accepted_at": {"type": "string", "format": "date-time"},
        "owner": {"type": "string", "minLength": 1, "maxLength": 39},
        "declared_model": {"type": "string", "minLength": 1, "maxLength": 256},
        "issue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "number", "identity_sha256"],
          "properties": {
            "repository": {"enum": ["leanprover/lean-eval", "leanprover/lean-eval-submissions"]},
            "number": {"type": "integer", "minimum": 1},
            "identity_sha256": {"$ref": "#/$defs/digest"}
          }
        },
        "historical_evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workflow_contract", "workflow_repository_commit",
            "workflow_definition_sha256", "workflow_run_id",
            "workflow_run_attempt", "workflow_run_identity_sha256"
          ],
          "properties": {
            "workflow_contract": {"enum": ["benchmark_repository_head", "split_repository_recorded_benchmark_v1"]},
            "workflow_repository_commit": {"$ref": "#/$defs/commit"},
            "workflow_definition_sha256": {"$ref": "#/$defs/digest"},
            "workflow_run_id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
            "workflow_run_attempt": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
            "workflow_run_identity_sha256": {"$ref": "#/$defs/digest"}
          }
        },
        "source": {"$ref": "#/$defs/source"},
        "benchmark": {"$ref": "#/$defs/benchmark"},
        "results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/result"}},
        "activation_requirement": {"const": "legacy_public_result_replay_authority_v1"}
      }
    }
  }
}
