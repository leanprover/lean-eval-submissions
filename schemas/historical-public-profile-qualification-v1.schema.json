{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanprover.github.io/lean-eval-submissions/schemas/historical-public-profile-qualification-v1.schema.json",
  "title": "Reviewed historical public replay profile qualification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "qualification_status", "benchmark_repository",
    "benchmark_commit", "benchmark_tree", "plan_repository", "plan_commit",
    "plan_path", "plan_sha256", "profile_matrix_path", "profile_matrix_sha256",
    "runner_contract_path", "runner_contract_sha256",
    "qualification_contract_path", "qualification_contract_sha256",
    "workflow_repository", "workflow_path", "workflow_run_id",
    "workflow_run_attempt", "controller_source_commit", "image_source_commit",
    "qualification_workflow_sha256", "qualification_controller_sha256",
    "artifact_provenance_sha256", "artifact_archive_bindings",
    "artifact_file_sha256", "registry_repository", "registry_tag",
    "registry_manifest_digest", "execution_profile", "execution_profile_digest",
    "measurement_config", "measurement_config_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "historical_public_replay_profile_qualification"},
    "qualification_status": {"const": "qualified"},
    "benchmark_repository": {"const": "leanprover/lean-eval"},
    "benchmark_commit": {"$ref": "#/$defs/commit"},
    "benchmark_tree": {"$ref": "#/$defs/commit"},
    "plan_repository": {"const": "leanprover/lean-eval-submissions"},
    "plan_commit": {"$ref": "#/$defs/commit"},
    "plan_path": {
      "type": "string",
      "pattern": "^evidence/public-replay/plans/[0-9a-f]{64}\\.json$"
    },
    "plan_sha256": {"$ref": "#/$defs/digest"},
    "profile_matrix_path": {
      "const": "configuration/historical-public-replay-profile-matrix-v1.json"
    },
    "profile_matrix_sha256": {"$ref": "#/$defs/digest"},
    "runner_contract_path": {"const": "configuration/historical-public-runner-v1.json"},
    "runner_contract_sha256": {"$ref": "#/$defs/digest"},
    "qualification_contract_path": {"const": "historical-public-qualification/contract-v1.json"},
    "qualification_contract_sha256": {"$ref": "#/$defs/digest"},
    "workflow_repository": {"const": "leanprover/lean-eval-submissions"},
    "workflow_path": {"const": ".github/workflows/historical-public-image-qualification.yml"},
    "workflow_run_id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "workflow_run_attempt": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "controller_source_commit": {"$ref": "#/$defs/commit"},
    "image_source_commit": {"$ref": "#/$defs/commit"},
    "qualification_workflow_sha256": {"$ref": "#/$defs/digest"},
    "qualification_controller_sha256": {"$ref": "#/$defs/digest"},
    "artifact_provenance_sha256": {"$ref": "#/$defs/digest"},
    "artifact_archive_bindings": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/candidateArtifact"},
        {"$ref": "#/$defs/stagingArtifact"}
      ],
      "items": false
    },
    "artifact_file_sha256": {
      "type": "object", "additionalProperties": false,
      "required": [
        "candidate-binding.json", "historical-image-publication.json",
        "historical-qualification-rollout.json",
        "historical-public-staging-qualification.json"
      ],
      "properties": {
        "candidate-binding.json": {"$ref": "#/$defs/digest"},
        "historical-image-publication.json": {"$ref": "#/$defs/digest"},
        "historical-qualification-rollout.json": {"$ref": "#/$defs/digest"},
        "historical-public-staging-qualification.json": {"$ref": "#/$defs/digest"}
      }
    },
    "registry_repository": {"const": "lean-eval-historical-public-v1"},
    "registry_tag": {"type": "string", "pattern": "^[0-9a-f]{40}-[0-9a-f]{40}$"},
    "registry_manifest_digest": {"$ref": "#/$defs/ociDigest"},
    "execution_profile": {"$ref": "replay-execution-profile-v1.schema.json"},
    "execution_profile_digest": {"$ref": "#/$defs/digest"},
    "measurement_config": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "wall_time_limit_ms", "memory_limit_bytes", "retired_instructions"],
      "properties": {
        "schema_version": {"const": 1},
        "wall_time_limit_ms": {"const": 19800000},
        "memory_limit_bytes": {"const": 12884901888},
        "retired_instructions": {
          "type": "object", "additionalProperties": false,
          "required": ["perf_event", "required"],
          "properties": {
            "perf_event": {"const": "instructions:u"},
            "required": {"const": false}
          }
        }
      }
    },
    "measurement_config_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ociDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "archive_sha256", "created_at", "name", "size_in_bytes"],
      "properties": {
        "artifact_id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "archive_sha256": {"$ref": "#/$defs/digest"},
        "created_at": {"type": "string", "pattern": "^(?!0000-)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "size_in_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "name": {"type": "string"}
      }
    },
    "candidateArtifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"properties": {"name": {"const": "historical-public-image-candidate"}}}
      ]
    },
    "stagingArtifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"properties": {"name": {"const": "historical-public-staging-qualification"}}}
      ]
    }
  }
}
