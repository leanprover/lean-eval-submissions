{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-lang.org/schemas/lean-eval/historical-final-delta-terminal-v1.schema.json",
  "title": "LeanEval final historical delta terminal binding version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "status", "activation", "executor_absence", "cutoff", "accepted_result_count", "terminal_result_count", "terminal_result_id_set_sha256", "lanes", "audit", "state", "retirement"],
  "properties": {
    "schema_version": {"const": 1}, "kind": {"const": "historical_final_delta_terminal_binding"}, "status": {"const": "terminal_and_executors_absent"},
    "activation": {"$ref": "#/$defs/locator"}, "executor_absence": {"$ref": "#/$defs/locator"},
    "cutoff": {"type": "object", "additionalProperties": false, "required": ["accepted_inventory", "delta_sha256", "delta_counts"], "properties": {"accepted_inventory": {"type": "object", "additionalProperties": false, "required": ["source_commit", "results_store_sha256", "inventory_sha256", "result_count"], "properties": {"source_commit": {"$ref": "#/$defs/commit"}, "results_store_sha256": {"$ref": "#/$defs/digest"}, "inventory_sha256": {"$ref": "#/$defs/digest"}, "result_count": {"$ref": "#/$defs/positiveCount"}}}, "delta_sha256": {"$ref": "#/$defs/digest"}, "delta_counts": {"type": "object", "additionalProperties": false, "required": ["result_count", "public_source_probe_pending", "private_archive_migration_pending"], "properties": {"result_count": {"$ref": "#/$defs/positiveCount"}, "public_source_probe_pending": {"$ref": "#/$defs/count"}, "private_archive_migration_pending": {"$ref": "#/$defs/count"}}}}},
    "accepted_result_count": {"$ref": "#/$defs/positiveCount"}, "terminal_result_count": {"$ref": "#/$defs/positiveCount"}, "terminal_result_id_set_sha256": {"$ref": "#/$defs/digest"},
    "lanes": {"type": "object", "additionalProperties": false, "required": ["public", "private"], "properties": {"public": {"$ref": "#/$defs/lane"}, "private": {"$ref": "#/$defs/lane"}}},
    "audit": {"allOf": [{"$ref": "#/$defs/head"}, {"properties": {"repository": {"const": "leanprover/lean-eval-audit"}}}]}, "state": {"allOf": [{"$ref": "#/$defs/head"}, {"properties": {"repository": {"const": "leanprover/lean-eval-state"}}}]},
    "retirement": {"const": {"audit_review_refs": ["refs/heads/historical-final-delta-archive-rewrap-v1"], "state_review_refs": ["refs/heads/historical-final-delta-state-v1"], "submissions_workflow_paths": [".github/workflows/historical-final-delta-activation.yml", ".github/workflows/historical-final-delta-archive-migration.yml", ".github/workflows/historical-final-delta-packet.yml", ".github/workflows/historical-final-delta-plans.yml", ".github/workflows/historical-final-delta-public-decisions.yml", ".github/workflows/historical-final-delta-state.yml", ".github/workflows/promote-historical-final-delta-archive-migration.yml"]}}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "count": {"type": "integer", "minimum": 0, "maximum": 10000}, "positiveCount": {"type": "integer", "minimum": 1, "maximum": 10000},
    "locator": {"type": "object", "additionalProperties": false, "required": ["repository", "commit", "path", "sha256"], "properties": {"repository": {"const": "leanprover/lean-eval-submissions"}, "commit": {"$ref": "#/$defs/commit"}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}}},
    "head": {"type": "object", "additionalProperties": false, "required": ["repository", "head", "tree"], "properties": {"repository": {"enum": ["leanprover/lean-eval-audit", "leanprover/lean-eval-state"]}, "head": {"$ref": "#/$defs/commit"}, "tree": {"$ref": "#/$defs/commit"}}},
    "lane": {"type": "object", "additionalProperties": false, "required": ["terminal_result_count", "terminal_result_id_set_sha256", "terminal_replay_event_count", "terminal_replay_event_id_set_sha256", "reviewed_unavailable_count"], "properties": {"terminal_result_count": {"$ref": "#/$defs/count"}, "terminal_result_id_set_sha256": {"$ref": "#/$defs/digest"}, "terminal_replay_event_count": {"$ref": "#/$defs/count"}, "terminal_replay_event_id_set_sha256": {"$ref": "#/$defs/digest"}, "reviewed_unavailable_count": {"$ref": "#/$defs/count"}}}
  }
}
