{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanprover.github.io/lean-eval-submissions/schemas/kernel-corpus-observations-v1.schema.json",
  "title": "Independent-kernel corpus observations version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "configuration_id", "configuration_sha256", "inventory_id", "inventory_sha256", "shard_index", "shard_count", "shard_id", "observations"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "kernel_corpus_observations"},
    "configuration_id": {"$ref": "#/$defs/configuration_id"},
    "configuration_sha256": {"$ref": "#/$defs/digest"},
    "inventory_id": {"$ref": "#/$defs/inventory_id"},
    "inventory_sha256": {"$ref": "#/$defs/digest"},
    "shard_index": {"$ref": "#/$defs/nonnegative_integer"},
    "shard_count": {"$ref": "#/$defs/positive_integer"},
    "shard_id": {"type": "string", "pattern": "^ksh1_[0-9a-f]{64}$"},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result_id", "replay_task_id", "replay_attempt", "attempt_id", "status", "outcome", "evidence_sha256", "statistics", "execution_receipt"],
        "properties": {
          "result_id": {"$ref": "#/$defs/result_id"},
          "replay_task_id": {"$ref": "#/$defs/replay_task_id"},
          "replay_attempt": {"$ref": "#/$defs/positive_integer"},
          "attempt_id": {"type": "string", "pattern": "^kca1_[0-9a-f]{64}$"},
          "status": {"enum": ["completed", "unavailable", "pending"]},
          "outcome": {"enum": ["accepted", "rejected", "declined", "crashed", "timed_out", "source_unavailable", "replay_unavailable", "export_unavailable", "replay_pending", "export_format_unsupported"]},
          "evidence_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
          "statistics": {"oneOf": [{"$ref": "#/$defs/statistics"}, {"type": "null"}]},
          "execution_receipt": {"oneOf": [{"$ref": "#/$defs/execution_receipt"}, {"type": "null"}]}
        },
        "allOf": [
          {"oneOf": [{"properties": {"statistics": {"type": "null"}, "execution_receipt": {"type": "null"}}}, {"properties": {"statistics": {"$ref": "#/$defs/statistics"}, "execution_receipt": {"$ref": "#/$defs/execution_receipt"}}}]},
          {"if": {"properties": {"status": {"const": "completed"}}}, "then": {"properties": {"outcome": {"enum": ["accepted", "rejected", "declined", "crashed", "timed_out"]}, "evidence_sha256": {"type": "null"}, "statistics": {"$ref": "#/$defs/statistics"}, "execution_receipt": {"$ref": "#/$defs/execution_receipt"}}}},
          {"if": {"properties": {"status": {"const": "unavailable"}}}, "then": {"properties": {"outcome": {"enum": ["source_unavailable", "replay_unavailable", "export_unavailable"]}, "evidence_sha256": {"$ref": "#/$defs/digest"}}}},
          {"if": {"properties": {"status": {"const": "pending"}}}, "then": {"properties": {"outcome": {"enum": ["replay_pending", "export_format_unsupported"]}}, "allOf": [{"if": {"properties": {"outcome": {"const": "replay_pending"}}}, "then": {"properties": {"evidence_sha256": {"type": "null"}}}}, {"if": {"properties": {"outcome": {"const": "export_format_unsupported"}}}, "then": {"properties": {"evidence_sha256": {"$ref": "#/$defs/digest"}}}}]}}
        ]
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "configuration_id": {"type": "string", "pattern": "^kcc1_[0-9a-f]{64}$"},
    "inventory_id": {"type": "string", "pattern": "^kci1_[0-9a-f]{64}$"},
    "result_id": {"type": "string", "pattern": "^r2_[0-9a-f]{64}$"},
    "replay_task_id": {"type": "string", "pattern": "^rt1_[0-9a-f]{64}$"},
    "nonnegative_integer": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positive_integer": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_ms", "peak_memory_bytes", "checker_invocations"],
      "properties": {
        "wall_time_ms": {"$ref": "#/$defs/nonnegative_integer"},
        "peak_memory_bytes": {"$ref": "#/$defs/nonnegative_integer"},
        "checker_invocations": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "execution_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "receipt_sha256", "attempt_id", "input_sha256", "configuration_id", "configuration_sha256", "outcome", "resource_limit_disposition", "statistics", "transcript_sha256", "runner_attestation_sha256", "source_free"],
      "properties": {
        "schema_version": {"const": 1},
        "receipt_sha256": {"$ref": "#/$defs/digest"},
        "attempt_id": {"type": "string", "pattern": "^kca1_[0-9a-f]{64}$"},
        "input_sha256": {"$ref": "#/$defs/digest"},
        "configuration_id": {"$ref": "#/$defs/configuration_id"},
        "configuration_sha256": {"$ref": "#/$defs/digest"},
        "outcome": {"enum": ["accepted", "rejected", "declined", "crashed", "timed_out", "export_unavailable", "export_format_unsupported"]},
        "resource_limit_disposition": {"enum": ["within_limits", "wall_timeout", "memory_limit"]},
        "statistics": {"$ref": "#/$defs/statistics"},
        "transcript_sha256": {"$ref": "#/$defs/digest"},
        "runner_attestation_sha256": {"$ref": "#/$defs/digest"},
        "source_free": {"const": true}
      }
    }
  }
}
