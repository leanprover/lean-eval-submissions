{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-lang.org/schemas/lean-eval/replay-queue-v1.schema.json",
  "title": "LeanEval deterministic replay queue schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "environment", "source_event_count", "source_digest", "tasks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "environment": { "enum": ["staging", "production"] },
    "source_event_count": { "type": "integer", "minimum": 1 },
    "source_digest": { "$ref": "#/$defs/digest" },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "uuid7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000-)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replay_task_id", "result_id", "submission_id", "problem_id",
        "statement_revision", "result_commit", "result_tree_digest",
        "source_repository", "source_commit", "source_visibility",
        "archive_repository", "archive_commit", "archive_path",
        "archive_ciphertext_sha256",
        "benchmark_repository", "benchmark_commit", "toolchain", "checker",
        "measurement_config_digest", "execution_profile_digest", "status",
        "attempt", "event_id", "occurred_at"
      ],
      "properties": {
        "replay_task_id": { "type": "string", "pattern": "^rt1_[0-9a-f]{64}$" },
        "result_id": { "type": "string", "pattern": "^r2_[0-9a-f]{64}$" },
        "submission_id": { "$ref": "#/$defs/uuid7" },
        "problem_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
        "statement_revision": {
          "type": "integer", "minimum": 1, "maximum": 9007199254740991
        },
        "result_commit": { "$ref": "#/$defs/commit" },
        "result_tree_digest": { "$ref": "#/$defs/digest" },
        "source_repository": { "$ref": "#/$defs/repository" },
        "source_commit": { "$ref": "#/$defs/commit" },
        "source_visibility": { "enum": ["private", "public"] },
        "archive_repository": { "$ref": "#/$defs/repository" },
        "archive_commit": { "$ref": "#/$defs/commit" },
        "archive_path": {
          "type": "string",
          "pattern": "^archives/[0-9a-f]{2}/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.tar\\.age$"
        },
        "archive_ciphertext_sha256": { "$ref": "#/$defs/digest" },
        "benchmark_repository": { "$ref": "#/$defs/repository" },
        "benchmark_commit": { "$ref": "#/$defs/commit" },
        "toolchain": {
          "type": "string",
          "pattern": "^leanprover/lean4:v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "checker": { "type": "string", "minLength": 1 },
        "measurement_config_digest": { "$ref": "#/$defs/digest" },
        "execution_profile_digest": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["queued", "failed"] },
        "attempt": { "type": "integer", "minimum": 0, "maximum": 3 },
        "event_id": { "$ref": "#/$defs/uuid7" },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "reason_code": {
          "enum": [
            "benchmark_fetch_failed", "runner_lost", "runner_start_failed",
            "source_fetch_failed"
          ]
        },
        "retryable": { "const": true }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "queued" } } },
          "then": {
            "properties": { "attempt": { "const": 0 } },
            "not": { "anyOf": [{ "required": ["reason_code"] }, { "required": ["retryable"] }] }
          }
        },
        {
          "if": { "properties": { "status": { "const": "failed" } } },
          "then": {
            "required": ["reason_code", "retryable"],
            "properties": { "attempt": { "type": "integer", "minimum": 1 } }
          }
        }
      ]
    }
  }
}
