{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanprover.github.io/lean-eval-submissions/schemas/unwrap-capability-v1.schema.json",
  "title": "Lean Eval single-submission unwrap capability v1 claims",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "request_id",
    "submission_id",
    "archive_repository",
    "archive_commit",
    "archive_path",
    "archive_ciphertext_sha256",
    "data_key_id",
    "runner_nonce",
    "issued_at",
    "expires_at",
    "max_uses"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "purpose": {
      "type": "string",
      "enum": ["lean-eval-release", "lean-eval-replay"]
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "submission_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "archive_repository": { "const": "leanprover/lean-eval-audit" },
    "archive_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "archive_path": {
      "type": "string",
      "pattern": "^archives/[0-9a-f]{2}/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.tar\\.age$"
    },
    "archive_ciphertext_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "data_key_id": {
      "type": "string",
      "pattern": "^ak1_[0-9a-f]{64}$"
    },
    "runner_nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issued_at": {
      "type": "string",
      "pattern": "^(?!0000-)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^(?!0000-)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "max_uses": { "const": 1 }
  }
}
