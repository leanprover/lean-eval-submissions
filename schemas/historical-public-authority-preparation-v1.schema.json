{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanprover.github.io/lean-eval-submissions/schemas/historical-public-authority-preparation-v1.schema.json",
  "title": "Blocked historical public State append preparation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "activation_status", "activation_blockers",
    "state_contract", "selection", "qualification_profile",
    "authority_event_payload", "profile_qualification_payload_without_commit",
    "qualification_commit_requirement", "ordinary_replay_enqueue"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "historical_public_authority_preparation"},
    "activation_status": {"const": "blocked"},
    "activation_blockers": {
      "const": [
        "review_and_commit_exact_qualification_profile",
        "supply_exact_qualification_commit",
        "supply_fresh_ordered_state_event_metadata",
        "validate_candidate_append_against_current_production_state",
        "separately_authorize_state_append_and_replay_enqueue"
      ]
    },
    "state_contract": {
      "type": "object", "additionalProperties": false,
      "required": [
        "repository", "commit", "tree", "event_schema_sha256",
        "historical_queue_schema_sha256", "validator_sha256", "materializer_sha256"
      ],
      "properties": {
        "repository": {"const": "leanprover/lean-eval-state"},
        "commit": {"$ref": "#/$defs/commit"},
        "tree": {"$ref": "#/$defs/commit"},
        "event_schema_sha256": {"$ref": "#/$defs/digest"},
        "historical_queue_schema_sha256": {"$ref": "#/$defs/digest"},
        "validator_sha256": {"$ref": "#/$defs/digest"},
        "materializer_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "result_id", "benchmark_commit"],
      "properties": {
        "request_id": {"type": "string", "pattern": "^prr_[0-9a-f]{64}$"},
        "result_id": {"$ref": "#/$defs/resultId"},
        "benchmark_commit": {"$ref": "#/$defs/commit"}
      }
    },
    "qualification_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "path", "sha256", "execution_profile_digest", "measurement_config_digest"],
      "properties": {
        "repository": {"const": "leanprover/lean-eval-submissions"},
        "path": {"type": "string", "pattern": "^evidence/public-replay/profiles/[0-9a-f]{64}\\.json$"},
        "sha256": {"$ref": "#/$defs/digest"},
        "execution_profile_digest": {"$ref": "#/$defs/digest"},
        "measurement_config_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "authority_event_payload": {
      "type": "object", "additionalProperties": false,
      "required": [
        "request_id", "historical_accepted_at", "owner_login", "declared_model",
        "problem_id", "statement_revision", "results_repository", "results_commit",
        "results_path", "result_file_sha256", "result_tree_digest", "source_kind",
        "source_repository", "source_commit", "benchmark_repository", "benchmark_commit",
        "toolchain", "lean_toolchain_blob_sha256", "workflow_run_identity_sha256",
        "authority_repository", "authority_commit", "authority_path", "authority_sha256"
      ],
      "properties": {
        "request_id": {"type": "string", "pattern": "^prr_[0-9a-f]{64}$"},
        "historical_accepted_at": {"type": "string", "pattern": "^(?!0000-)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "owner_login": {"$ref": "#/$defs/login"},
        "declared_model": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "problem_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
        "statement_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "results_repository": {"const": "leanprover/lean-eval-submissions"},
        "results_commit": {"$ref": "#/$defs/commit"},
        "results_path": {"type": "string", "pattern": "^results/[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?\\.json$"},
        "result_file_sha256": {"$ref": "#/$defs/digest"},
        "result_tree_digest": {"$ref": "#/$defs/digest"},
        "source_kind": {"enum": ["github_repo", "gist"]},
        "source_repository": {"$ref": "#/$defs/repository"},
        "source_commit": {"$ref": "#/$defs/commit"},
        "benchmark_repository": {"const": "leanprover/lean-eval"},
        "benchmark_commit": {"$ref": "#/$defs/commit"},
        "toolchain": {"$ref": "#/$defs/toolchain"},
        "lean_toolchain_blob_sha256": {"$ref": "#/$defs/digest"},
        "workflow_run_identity_sha256": {"$ref": "#/$defs/digest"},
        "authority_repository": {"const": "leanprover/lean-eval-submissions"},
        "authority_commit": {"$ref": "#/$defs/commit"},
        "authority_path": {"type": "string", "pattern": "^evidence/public-replay/plans/[0-9a-f]{64}\\.json$"},
        "authority_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "profile_qualification_payload_without_commit": {
      "type": "object", "additionalProperties": false,
      "required": ["toolchain", "execution_profile_digest", "qualification_repository", "qualification_path", "qualification_sha256"],
      "properties": {
        "toolchain": {"$ref": "#/$defs/toolchain"},
        "execution_profile_digest": {"$ref": "#/$defs/digest"},
        "qualification_repository": {"const": "leanprover/lean-eval-submissions"},
        "qualification_path": {"type": "string", "pattern": "^evidence/public-replay/profiles/[0-9a-f]{64}\\.json$"},
        "qualification_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "qualification_commit_requirement": {
      "const": "exact commit containing the byte-identical qualification profile at its digest-derived path"
    },
    "ordinary_replay_enqueue": {
      "type": "object", "additionalProperties": false,
      "required": ["replay_task_id", "payload"],
      "properties": {
        "replay_task_id": {"type": "string", "pattern": "^rt1_[0-9a-f]{64}$"},
        "payload": {
          "type": "object", "additionalProperties": false,
          "required": ["result_id", "measurement_config_digest", "execution_profile_digest", "checker"],
          "properties": {
            "result_id": {"$ref": "#/$defs/resultId"},
            "measurement_config_digest": {"$ref": "#/$defs/digest"},
            "execution_profile_digest": {"$ref": "#/$defs/digest"},
            "checker": {"const": "nanoda"}
          }
        }
      }
    }
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resultId": {"type": "string", "pattern": "^r2_[0-9a-f]{64}$"},
    "login": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?$"},
    "repository": {"type": "string", "pattern": "^(?!\\.{1,2}/)(?![^/]+/\\.{1,2}$)[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "toolchain": {"type": "string", "pattern": "^leanprover/lean4:v[0-9]+\\.[0-9]+\\.[0-9]+(?:-(?:rc|beta)[0-9]+)?$"}
  }
}
