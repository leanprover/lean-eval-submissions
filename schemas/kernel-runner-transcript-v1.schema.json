{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanprover.github.io/lean-eval-submissions/schemas/kernel-runner-transcript-v1.schema.json",
  "title": "Independent-kernel structured runner transcript version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "attempt_id", "input_sha256", "invocation_sha256", "termination", "statistics", "stdout_sha256", "stdout_size_bytes", "stdout_truncated", "stderr_sha256", "stderr_size_bytes", "stderr_truncated", "classification"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "kernel_runner_transcript"},
    "attempt_id": {"type": "string", "pattern": "^kca1_[0-9a-f]{64}$"},
    "input_sha256": {"$ref": "#/$defs/digest"},
    "invocation_sha256": {"$ref": "#/$defs/digest"},
    "termination": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "reason", "evidence_sha256", "validator_code", "observed_input_sha256"], "properties": {"kind": {"const": "not_started"}, "reason": {"enum": ["export_unavailable", "export_format_unsupported"]}, "evidence_sha256": {"$ref": "#/$defs/digest"}, "validator_code": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.+-]+$"}, "observed_input_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "code"], "properties": {"kind": {"const": "exited"}, "code": {"type": "integer", "minimum": 0, "maximum": 255}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "signal"], "properties": {"kind": {"const": "signaled"}, "signal": {"type": "integer", "minimum": 1, "maximum": 127}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "evidence_sha256", "limiter_code"], "properties": {"kind": {"const": "timed_out"}, "evidence_sha256": {"$ref": "#/$defs/digest"}, "limiter_code": {"$ref": "#/$defs/validator_code"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "evidence_sha256", "limiter_code"], "properties": {"kind": {"const": "memory_limit"}, "evidence_sha256": {"$ref": "#/$defs/digest"}, "limiter_code": {"$ref": "#/$defs/validator_code"}}}
      ]
    },
    "statistics": {"$ref": "#/$defs/statistics"},
    "stdout_sha256": {"$ref": "#/$defs/digest"},
    "stdout_size_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
    "stdout_truncated": {"const": false},
    "stderr_sha256": {"$ref": "#/$defs/digest"},
    "stderr_size_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
    "stderr_truncated": {"const": false},
    "classification": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["status", "outcome", "reason"], "properties": {"status": {"const": "classified"}, "outcome": {"enum": ["accepted", "declined", "crashed", "timed_out", "export_unavailable", "export_format_unsupported"]}, "reason": {"type": "null"}}},
        {"type": "object", "additionalProperties": false, "required": ["status", "outcome", "reason"], "properties": {"status": {"const": "blocked"}, "outcome": {"type": "null"}, "reason": {"enum": ["ambiguous_exit_status", "unregistered_exit_status", "ambiguous_signal"]}}}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"termination": {"properties": {"kind": {"const": "exited"}, "code": {"const": 0}}, "required": ["kind", "code"]}}}, "then": {"properties": {"statistics": {"properties": {"checker_invocations": {"const": 1}}}, "classification": {"const": {"status": "classified", "outcome": "accepted", "reason": null}}}}},
    {"if": {"properties": {"termination": {"properties": {"kind": {"const": "exited"}, "code": {"const": 1}}, "required": ["kind", "code"]}}}, "then": {"properties": {"statistics": {"properties": {"checker_invocations": {"const": 1}}}, "classification": {"const": {"status": "blocked", "outcome": null, "reason": "ambiguous_exit_status"}}}}},
    {"if": {"properties": {"termination": {"properties": {"kind": {"const": "exited"}, "code": {"const": 2}}, "required": ["kind", "code"]}}}, "then": {"properties": {"statistics": {"properties": {"checker_invocations": {"const": 1}}}, "classification": {"const": {"status": "classified", "outcome": "declined", "reason": null}}}}},
    {"if": {"properties": {"termination": {"properties": {"kind": {"const": "exited"}, "code": {"not": {"enum": [0, 1, 2]}}}, "required": ["kind", "code"]}}}, "then": {"properties": {"statistics": {"properties": {"checker_invocations": {"const": 1}}}, "classification": {"const": {"status": "blocked", "outcome": null, "reason": "unregistered_exit_status"}}}}},
    {"if": {"properties": {"termination": {"properties": {"kind": {"const": "signaled"}, "signal": {"enum": [4, 6, 7, 8, 11]}}, "required": ["kind", "signal"]}}}, "then": {"properties": {"statistics": {"properties": {"checker_invocations": {"const": 1}}}, "classification": {"const": {"status": "classified", "outcome": "crashed", "reason": null}}}}},
    {"if": {"properties": {"termination": {"properties": {"kind": {"const": "signaled"}, "signal": {"not": {"enum": [4, 6, 7, 8, 11]}}}, "required": ["kind", "signal"]}}}, "then": {"properties": {"statistics": {"properties": {"checker_invocations": {"const": 1}}}, "classification": {"const": {"status": "blocked", "outcome": null, "reason": "ambiguous_signal"}}}}},
    {"if": {"properties": {"termination": {"properties": {"kind": {"const": "not_started"}, "reason": {"const": "export_unavailable"}}, "required": ["kind", "reason"]}}}, "then": {"properties": {"termination": {"properties": {"observed_input_sha256": {"type": "null"}}}, "statistics": {"const": {"wall_time_ms": 0, "peak_memory_bytes": 0, "checker_invocations": 0}}, "stdout_size_bytes": {"const": 0}, "stderr_size_bytes": {"const": 0}, "classification": {"const": {"status": "classified", "outcome": "export_unavailable", "reason": null}}}}},
    {"if": {"properties": {"termination": {"properties": {"kind": {"const": "not_started"}, "reason": {"const": "export_format_unsupported"}}, "required": ["kind", "reason"]}}}, "then": {"properties": {"termination": {"properties": {"observed_input_sha256": {"$ref": "#/$defs/digest"}}}, "statistics": {"const": {"wall_time_ms": 0, "peak_memory_bytes": 0, "checker_invocations": 0}}, "stdout_size_bytes": {"const": 0}, "stderr_size_bytes": {"const": 0}, "classification": {"const": {"status": "classified", "outcome": "export_format_unsupported", "reason": null}}}}},
    {"if": {"properties": {"termination": {"properties": {"kind": {"const": "timed_out"}}, "required": ["kind"]}}}, "then": {"properties": {"statistics": {"properties": {"checker_invocations": {"const": 1}}}, "classification": {"const": {"status": "classified", "outcome": "timed_out", "reason": null}}}}},
    {"if": {"properties": {"termination": {"properties": {"kind": {"const": "memory_limit"}}, "required": ["kind"]}}}, "then": {"properties": {"statistics": {"properties": {"checker_invocations": {"const": 1}}}, "classification": {"const": {"status": "classified", "outcome": "crashed", "reason": null}}}}},
    {"if": {"properties": {"stdout_size_bytes": {"const": 0}}}, "then": {"properties": {"stdout_sha256": {"const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}}}},
    {"if": {"properties": {"stderr_size_bytes": {"const": 0}}}, "then": {"properties": {"stderr_sha256": {"const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}}}},
    {"if": {"properties": {"stdout_sha256": {"const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}}}, "then": {"properties": {"stdout_size_bytes": {"const": 0}}}},
    {"if": {"properties": {"stderr_sha256": {"const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}}}, "then": {"properties": {"stderr_size_bytes": {"const": 0}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validator_code": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.+-]+$"},
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_ms", "peak_memory_bytes", "checker_invocations"],
      "properties": {
        "wall_time_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "peak_memory_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "checker_invocations": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    }
  }
}
