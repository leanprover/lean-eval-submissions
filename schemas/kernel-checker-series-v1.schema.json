{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanprover.github.io/lean-eval-submissions/schemas/kernel-checker-series-v1.schema.json",
  "title": "Independent-kernel checker series version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "series_name", "configuration_id", "candidate", "producer_profiles", "checker", "runner"],
  "properties": {
    "schema_version": {"const": 1},
    "series_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"},
    "configuration_id": {"type": "string", "pattern": "^kcc1_[0-9a-f]{64}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "name", "binary_sha256", "protocol", "configuration_policy_sha256"],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "commit": {"$ref": "#/$defs/commit"},
        "name": {"$ref": "#/$defs/safe_name"},
        "binary_sha256": {"$ref": "#/$defs/digest"},
        "protocol": {"$ref": "#/$defs/safe_name"},
        "configuration_policy_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "producer_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["benchmark_repository", "benchmark_commit", "exporter", "lean"],
        "properties": {
          "benchmark_repository": {"const": "leanprover/lean-eval"},
          "benchmark_commit": {"$ref": "#/$defs/commit"},
          "exporter": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "commit", "binary_sha256", "name", "version", "format_version", "format_specification_sha256", "format_specification_path"],
            "properties": {
              "repository": {"const": "leanprover/lean4export"},
              "commit": {"$ref": "#/$defs/commit"},
              "binary_sha256": {"$ref": "#/$defs/digest"},
              "name": {"const": "lean4export"},
              "version": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
              "format_version": {"const": "3.1.0"},
              "format_specification_sha256": {"const": "f82a21e17e4258a1043895d0653ea4333bef8cb07aad2e3d6c1fc4be52b138e3"},
              "format_specification_path": {"const": "format_ndjson.md"}
            }
          },
          "lean": {
            "type": "object",
            "additionalProperties": false,
            "required": ["toolchain", "version", "githash"],
            "properties": {
              "toolchain": {"type": "string", "pattern": "^leanprover/lean4:v[0-9]+\\.[0-9]+\\.[0-9]+(?:-(?:rc|beta)[0-9]+)?$"},
              "version": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
              "githash": {"$ref": "#/$defs/commit"}
            }
          }
        }
      }
    },
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "protocol"],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "commit": {"$ref": "#/$defs/commit"},
        "protocol": {"$ref": "#/$defs/safe_name"}
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "image_digest", "architecture", "operating_system", "resource_limits"],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "commit": {"$ref": "#/$defs/commit"},
        "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "architecture": {"$ref": "#/$defs/safe_name"},
        "operating_system": {"$ref": "#/$defs/safe_name"},
        "resource_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wall_timeout_seconds", "max_memory_bytes"],
          "properties": {
            "wall_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 9007199254740},
            "max_memory_bytes": {"$ref": "#/$defs/positive_integer"}
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository": {"type": "string", "pattern": "^(?!\\.{1,2}/)(?![^/]+/\\.{1,2}$)[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "safe_name": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]{1,128}$"},
    "positive_integer": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
  }
}
