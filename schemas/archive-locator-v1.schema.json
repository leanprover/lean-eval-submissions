{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanprover.github.io/lean-eval-submissions/schemas/archive-locator-v1.schema.json",
  "title": "LeanEval immutable archive locator v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "archive_repository",
    "archive_commit",
    "archive_path",
    "archive_ciphertext_sha256",
    "encrypted"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "submission_id": {
      "$ref": "#/$defs/uuid7"
    },
    "archive_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "archive_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "archive_path": {
      "type": "string",
      "pattern": "^archives/[0-9a-f]{2}/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.tar\\.age$"
    },
    "archive_ciphertext_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "encrypted": {
      "const": true
    }
  },
  "$defs": {
    "uuid7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
