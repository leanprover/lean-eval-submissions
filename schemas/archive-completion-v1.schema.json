{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanprover.github.io/lean-eval-submissions/schemas/archive-completion-v1.schema.json",
  "title": "LeanEval verified archive completion schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "occurred_at", "locator"],
  "properties": {
    "schema_version": { "const": 1 },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "locator": { "$ref": "archive-locator-v1.schema.json" }
  }
}
