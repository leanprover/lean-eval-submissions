{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanprover.github.io/lean-eval/schemas/public-replay-resolution-requests-v1.schema.json",
  "title": "Historical public replay resolution requests v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source_repository",
    "source_commit",
    "inventory_sha256",
    "request_count",
    "result_count",
    "requests"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "historical_public_replay_resolution_requests" },
    "source_repository": { "const": "leanprover/lean-eval-submissions" },
    "source_commit": { "$ref": "#/$defs/commit" },
    "inventory_sha256": { "$ref": "#/$defs/digest" },
    "request_count": { "type": "integer", "minimum": 1 },
    "result_count": { "type": "integer", "minimum": 1 },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/request" }
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "result_id": { "type": "string", "pattern": "^r2_[0-9a-f]{64}$" },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "owner",
        "issue_number",
        "accepted_at",
        "declared_model",
        "source",
        "benchmark",
        "candidate_issue_repositories",
        "expected_workflow",
        "readiness",
        "results"
      ],
      "properties": {
        "request_id": { "type": "string", "pattern": "^prr_[0-9a-f]{64}$" },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
        },
        "issue_number": { "type": "integer", "minimum": 1 },
        "accepted_at": {
          "type": "string",
          "pattern": "^(?!0000-)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "declared_model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository", "commit", "visibility"],
          "properties": {
            "kind": { "enum": ["github_repo", "gist"] },
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "commit": { "$ref": "#/$defs/commit" },
            "visibility": { "const": "public" }
          }
        },
        "benchmark": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "commit"],
          "properties": {
            "repository": { "const": "leanprover/lean-eval" },
            "commit": { "$ref": "#/$defs/commit" }
          }
        },
        "candidate_issue_repositories": {
          "const": [
            "leanprover/lean-eval",
            "leanprover/lean-eval-submissions"
          ]
        },
        "expected_workflow": {
          "const": { "event": "issues", "name": "Submission" }
        },
        "readiness": { "const": "github_evidence_fetch_pending" },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["result_id", "owner", "problem_id", "statement_revision"],
            "properties": {
              "result_id": { "$ref": "#/$defs/result_id" },
              "owner": {
                "type": "string",
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
              },
              "problem_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
              },
              "statement_revision": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
