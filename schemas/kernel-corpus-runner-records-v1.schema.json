{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanprover.github.io/lean-eval-submissions/schemas/kernel-corpus-runner-records-v1.schema.json",
  "title": "Independent-kernel source-free runner record bundle version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "configuration_id", "configuration_sha256", "inventory_id", "inventory_sha256", "shard_id", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "kernel_corpus_runner_records"},
    "configuration_id": {"type": "string", "pattern": "^kcc1_[0-9a-f]{64}$"},
    "configuration_sha256": {"$ref": "#/$defs/digest"},
    "inventory_id": {"type": "string", "pattern": "^kci1_[0-9a-f]{64}$"},
    "inventory_sha256": {"$ref": "#/$defs/digest"},
    "shard_id": {"type": "string", "pattern": "^ksh1_[0-9a-f]{64}$"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt_id", "input_sha256", "outcome", "evidence_sha256", "resource_limit_disposition", "statistics", "transcript_sha256", "runner_attestation_sha256", "source_free"],
        "properties": {
          "attempt_id": {"type": "string", "pattern": "^kca1_[0-9a-f]{64}$"},
          "input_sha256": {"$ref": "#/$defs/digest"},
          "outcome": {"enum": ["accepted", "declined", "crashed", "timed_out", "export_unavailable", "export_format_unsupported"]},
          "evidence_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
          "resource_limit_disposition": {"enum": ["within_limits", "wall_timeout", "memory_limit"]},
          "statistics": {"$ref": "#/$defs/statistics"},
          "transcript_sha256": {"$ref": "#/$defs/digest"},
          "runner_attestation_sha256": {"$ref": "#/$defs/digest"},
          "source_free": {"const": true}
        },
        "allOf": [
          {"if": {"properties": {"outcome": {"enum": ["accepted", "declined", "crashed", "timed_out"]}}}, "then": {"properties": {"evidence_sha256": {"type": "null"}, "statistics": {"properties": {"checker_invocations": {"minimum": 1}}}}}},
          {"if": {"properties": {"outcome": {"enum": ["export_unavailable", "export_format_unsupported"]}}}, "then": {"properties": {"evidence_sha256": {"$ref": "#/$defs/digest"}, "statistics": {"properties": {"checker_invocations": {"const": 0}}}}}}
        ]
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonnegative_integer": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_ms", "peak_memory_bytes", "checker_invocations"],
      "properties": {
        "wall_time_ms": {"$ref": "#/$defs/nonnegative_integer"},
        "peak_memory_bytes": {"$ref": "#/$defs/nonnegative_integer"},
        "checker_invocations": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    }
  }
}
