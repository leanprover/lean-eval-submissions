{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanprover.github.io/lean-eval-submissions/schemas/kernel-corpus-shard-plan-v1.schema.json",
  "title": "Independent-kernel corpus shard plan version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "configuration_id", "configuration_sha256", "inventory_id", "inventory_sha256", "shard_index", "shard_count", "shard_id", "attempts"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "kernel_corpus_shard_plan"},
    "configuration_id": {"$ref": "#/$defs/configuration_id"},
    "configuration_sha256": {"$ref": "#/$defs/digest"},
    "inventory_id": {"$ref": "#/$defs/inventory_id"},
    "inventory_sha256": {"$ref": "#/$defs/digest"},
    "shard_index": {"$ref": "#/$defs/nonnegative_integer"},
    "shard_count": {"$ref": "#/$defs/positive_integer"},
    "shard_id": {"type": "string", "pattern": "^ksh1_[0-9a-f]{64}$"},
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result_id", "replay_task_id", "replay_attempt", "problem_id", "statement_revision", "benchmark_repository", "benchmark_commit", "benchmark_configuration_sha256", "terminal_verdict_sha256", "terminal_event_sha256", "report_entry_sha256", "replay_export_input_sha256", "attempt_id", "required_action"],
        "properties": {
          "result_id": {"$ref": "#/$defs/result_id"},
          "replay_task_id": {"$ref": "#/$defs/replay_task_id"},
          "replay_attempt": {"$ref": "#/$defs/positive_integer"},
          "problem_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
          "statement_revision": {"$ref": "#/$defs/positive_integer"},
          "benchmark_repository": {"const": "leanprover/lean-eval"},
          "benchmark_commit": {"$ref": "#/$defs/commit"},
          "benchmark_configuration_sha256": {"$ref": "#/$defs/digest"},
          "terminal_verdict_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
          "terminal_event_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
          "report_entry_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
          "replay_export_input_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
          "attempt_id": {"type": "string", "pattern": "^kca1_[0-9a-f]{64}$"},
          "required_action": {"enum": ["run", "record_replay_pending", "record_source_unavailable", "record_replay_unavailable"]}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "configuration_id": {"type": "string", "pattern": "^kcc1_[0-9a-f]{64}$"},
    "inventory_id": {"type": "string", "pattern": "^kci1_[0-9a-f]{64}$"},
    "result_id": {"type": "string", "pattern": "^r2_[0-9a-f]{64}$"},
    "replay_task_id": {"type": "string", "pattern": "^rt1_[0-9a-f]{64}$"},
    "nonnegative_integer": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positive_integer": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
  }
}
