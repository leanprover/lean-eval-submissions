{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanprover.github.io/lean-eval-submissions/schemas/evaluation-completion-v1.schema.json",
  "title": "LeanEval trusted evaluation completion schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "submission_id", "attempt", "occurred_at",
    "benchmark_repository", "benchmark_commit", "toolchain", "outcome"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "submission_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000-)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "benchmark_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "benchmark_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "toolchain": {
      "type": "string",
      "pattern": "^leanprover/lean4:v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "evaluator_version"],
          "properties": {
            "status": { "const": "accepted" },
            "evaluator_version": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason_code"],
          "properties": {
            "status": { "const": "rejected" },
            "reason_code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason_code", "retryable"],
          "properties": {
            "status": { "const": "failed" },
            "reason_code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
            "retryable": { "type": "boolean" }
          }
        }
      ]
    }
  }
}
