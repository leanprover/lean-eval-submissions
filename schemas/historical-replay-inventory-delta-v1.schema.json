{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanprover.github.io/lean-eval/schemas/historical-replay-inventory-delta-v1.schema.json",
  "title": "LeanEval append-only historical replay inventory delta version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source_repository",
    "baseline",
    "current",
    "delta_counts",
    "server_exclusions",
    "entries"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "historical_replay_inventory_delta"},
    "source_repository": {"const": "leanprover/lean-eval-submissions"},
    "baseline": {"$ref": "#/$defs/inventory_identity"},
    "current": {"$ref": "#/$defs/inventory_identity"},
    "delta_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_count",
        "public_source_probe_pending",
        "private_archive_migration_pending",
        "server_native_excluded"
      ],
      "properties": {
        "result_count": {"type": "integer", "minimum": 0, "maximum": 10000},
        "public_source_probe_pending": {"type": "integer", "minimum": 0},
        "private_archive_migration_pending": {"type": "integer", "minimum": 0},
        "server_native_excluded": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    },
    "server_exclusions": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/server_exclusion"}
    },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "historical-replay-inventory-v1.schema.json#/$defs/entry"}
    }
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_id": {"type": "string", "pattern": "^r2_[0-9a-f]{64}$"},
    "uuid7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "server_exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "submission_id",
        "results_path",
        "result_file_sha256",
        "result_tree_digest"
      ],
      "properties": {
        "result_id": {"$ref": "#/$defs/result_id"},
        "submission_id": {"$ref": "#/$defs/uuid7"},
        "results_path": {"type": "string", "pattern": "^results/[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?\\.json$"},
        "result_file_sha256": {"$ref": "#/$defs/digest"},
        "result_tree_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "inventory_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "results_store_sha256",
        "inventory_sha256",
        "result_count"
      ],
      "properties": {
        "source_commit": {"$ref": "#/$defs/commit"},
        "results_store_sha256": {"$ref": "#/$defs/digest"},
        "inventory_sha256": {"$ref": "#/$defs/digest"},
        "result_count": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    }
  }
}
