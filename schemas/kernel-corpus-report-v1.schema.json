{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanprover.github.io/lean-eval-submissions/schemas/kernel-corpus-report-v1.schema.json",
  "title": "Independent-kernel corpus aggregate report version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "configuration_id", "configuration_sha256", "inventory_id", "inventory_sha256", "shard_count", "plan_set_sha256", "observation_set_sha256", "coverage", "counters", "performance", "disagreements", "promotion"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "kernel_corpus_report"},
    "configuration_id": {"type": "string", "pattern": "^kcc1_[0-9a-f]{64}$"},
    "configuration_sha256": {"$ref": "#/$defs/digest"},
    "inventory_id": {"type": "string", "pattern": "^kci1_[0-9a-f]{64}$"},
    "inventory_sha256": {"$ref": "#/$defs/digest"},
    "shard_count": {"$ref": "#/$defs/positive_integer"},
    "plan_set_sha256": {"$ref": "#/$defs/digest"},
    "observation_set_sha256": {"$ref": "#/$defs/digest"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory_results", "observations", "complete"],
      "properties": {
        "inventory_results": {"$ref": "#/$defs/positive_integer"},
        "observations": {"$ref": "#/$defs/positive_integer"},
        "complete": {"const": true}
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "rejected", "declined", "crashed", "timed_out", "source_unavailable", "replay_unavailable", "export_unavailable", "replay_pending", "export_format_unsupported"],
      "properties": {
        "accepted": {"$ref": "#/$defs/nonnegative_integer"},
        "rejected": {"$ref": "#/$defs/nonnegative_integer"},
        "declined": {"$ref": "#/$defs/nonnegative_integer"},
        "crashed": {"$ref": "#/$defs/nonnegative_integer"},
        "timed_out": {"$ref": "#/$defs/nonnegative_integer"},
        "source_unavailable": {"$ref": "#/$defs/nonnegative_integer"},
        "replay_unavailable": {"$ref": "#/$defs/nonnegative_integer"},
        "export_unavailable": {"$ref": "#/$defs/nonnegative_integer"},
        "replay_pending": {"$ref": "#/$defs/nonnegative_integer"},
        "export_format_unsupported": {"$ref": "#/$defs/nonnegative_integer"}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "wall_time_ms", "peak_memory_bytes", "checker_invocations"],
      "properties": {
        "sample_count": {"$ref": "#/$defs/nonnegative_integer"},
        "wall_time_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum", "median_upper", "p95_nearest_rank", "sum"],
          "properties": {
            "minimum": {"$ref": "#/$defs/nullable_integer"},
            "maximum": {"$ref": "#/$defs/nullable_integer"},
            "median_upper": {"$ref": "#/$defs/nullable_integer"},
            "p95_nearest_rank": {"$ref": "#/$defs/nullable_integer"},
            "sum": {"$ref": "#/$defs/nonnegative_integer"}
          }
        },
        "peak_memory_bytes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximum"],
          "properties": {"maximum": {"$ref": "#/$defs/nullable_integer"}}
        },
        "checker_invocations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sum"],
          "properties": {"sum": {"$ref": "#/$defs/nonnegative_integer"}}
        }
      }
    },
    "disagreements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result_id", "authoritative_outcome", "candidate_outcome", "adjudication"],
        "properties": {
          "result_id": {"type": "string", "pattern": "^r2_[0-9a-f]{64}$"},
          "authoritative_outcome": {"$ref": "#/$defs/terminal_outcome"},
          "candidate_outcome": {"$ref": "#/$defs/candidate_terminal_outcome"},
          "adjudication": {"const": "required"}
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automated_eligibility", "blocking_reasons"],
      "properties": {
        "automated_eligibility": {"const": false},
        "blocking_reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": {"const": "human_promotion_review_required"},
          "items": {"enum": ["human_promotion_review_required", "corpus_unavailable_results", "corpus_pending_results", "export_format_review_required", "disagreement_adjudication_required"]}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonnegative_integer": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positive_integer": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "nullable_integer": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
    "terminal_outcome": {"enum": ["accepted", "rejected", "declined", "crashed", "timed_out"]},
    "candidate_terminal_outcome": {"enum": ["accepted", "declined", "crashed", "timed_out"]}
  }
}
