{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanprover.github.io/lean-eval/schemas/historical-replay-inventory-v1.schema.json",
  "title": "LeanEval historical replay inventory schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_repository",
    "source_commit",
    "results_store_sha256",
    "result_count",
    "classification_counts",
    "entries"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source_repository": {"const": "leanprover/lean-eval-submissions"},
    "source_commit": {"$ref": "#/$defs/commit"},
    "results_store_sha256": {"$ref": "#/$defs/digest"},
    "result_count": {"type": "integer", "minimum": 1},
    "classification_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_source_probe_pending",
        "private_archive_migration_pending"
      ],
      "properties": {
        "public_source_probe_pending": {"type": "integer", "minimum": 0},
        "private_archive_migration_pending": {"type": "integer", "minimum": 0}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_id": {"type": "string", "pattern": "^r2_[0-9a-f]{64}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "owner",
        "results_path",
        "problem_id",
        "statement_revision",
        "accepted_at",
        "benchmark_commit",
        "source"
      ],
      "properties": {
        "result_id": {"$ref": "#/$defs/result_id"},
        "owner": {"type": "string", "minLength": 1},
        "results_path": {
          "type": "string",
          "pattern": "^results/[A-Za-z0-9][A-Za-z0-9_.-]*\\.json$"
        },
        "problem_id": {"type": "string", "minLength": 1},
        "statement_revision": {"type": "integer", "minimum": 1},
        "accepted_at": {"type": "string", "format": "date-time"},
        "benchmark_commit": {"$ref": "#/$defs/commit"},
        "source": {
          "oneOf": [
            {"$ref": "#/$defs/public_source"},
            {"$ref": "#/$defs/private_source"}
          ]
        }
      }
    },
    "public_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "visibility", "readiness", "repository", "commit"],
      "properties": {
        "kind": {"enum": ["github_repo", "gist"]},
        "visibility": {"const": "public"},
        "readiness": {"const": "public_source_probe_pending"},
        "repository": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/commit"}
      }
    },
    "private_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "visibility", "readiness"],
      "properties": {
        "kind": {"enum": ["github_repo", "gist"]},
        "visibility": {"const": "private"},
        "readiness": {"const": "private_archive_migration_pending"}
      }
    }
  }
}
