{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanprover.github.io/lean-eval-submissions/schemas/historical-public-replay-profile-matrix-v1.schema.json",
  "title": "Historical public replay source-free profile build matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "plan_sha256", "toolchain_registry_sha256",
    "component_lock_sha256", "qualification_status",
    "qualification_requirements", "image_count", "toolchain_count",
    "request_count", "result_count", "images"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "historical_public_replay_profile_matrix"},
    "plan_sha256": {"$ref": "#/$defs/digest"},
    "toolchain_registry_sha256": {"$ref": "#/$defs/digest"},
    "component_lock_sha256": {"$ref": "#/$defs/digest"},
    "qualification_status": {"const": "unqualified"},
    "qualification_requirements": {
      "const": [
        "historical_public_runner_v1",
        "immutable_registry_publication_v1",
        "cloudflare_staging_runtime_probe_v1"
      ]
    },
    "image_count": {"type": "integer", "minimum": 1},
    "toolchain_count": {"type": "integer", "minimum": 1},
    "request_count": {"type": "integer", "minimum": 1},
    "result_count": {"type": "integer", "minimum": 1},
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/image"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "problem": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "toolchain": {
      "type": "string",
      "pattern": "^leanprover/lean4:v[0-9]+\\.[0-9]+\\.[0-9]+(?:-(?:rc|beta)[0-9]+)?$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "commit": {"$ref": "#/$defs/commit"}
      }
    },
    "profileLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "benchmark_repository", "benchmark_commit",
        "toolchain", "runner_profile", "go_toolchain", "rust_toolchain",
        "cache_state", "measurement_command", "components"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "benchmark_repository": {"const": "leanprover/lean-eval"},
        "benchmark_commit": {"$ref": "#/$defs/commit"},
        "toolchain": {"$ref": "#/$defs/toolchain"},
        "runner_profile": {"type": "string", "minLength": 1},
        "go_toolchain": {"type": "string", "pattern": "^go[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "rust_toolchain": {"type": "string", "pattern": "^rustc-[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "cache_state": {"enum": ["cold", "warm"]},
        "measurement_command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["comparator", "landrun", "lean4export", "nanoda"],
          "properties": {
            "comparator": {"$ref": "#/$defs/component"},
            "landrun": {"$ref": "#/$defs/component"},
            "lean4export": {"$ref": "#/$defs/component"},
            "nanoda": {"$ref": "#/$defs/component"}
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_commit", "benchmark_tree", "toolchain",
        "lean_toolchain_blob_sha256", "manifest_layout", "workspace_count",
        "request_count", "result_count", "problem_ids", "profile_lock",
        "qualification_status"
      ],
      "properties": {
        "benchmark_commit": {"$ref": "#/$defs/commit"},
        "benchmark_tree": {"$ref": "#/$defs/commit"},
        "toolchain": {"$ref": "#/$defs/toolchain"},
        "lean_toolchain_blob_sha256": {"$ref": "#/$defs/digest"},
        "manifest_layout": {"enum": ["monolith_v1", "per_problem_v1"]},
        "workspace_count": {"type": "integer", "minimum": 1},
        "request_count": {"type": "integer", "minimum": 1},
        "result_count": {"type": "integer", "minimum": 1},
        "problem_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/problem"}
        },
        "profile_lock": {"$ref": "#/$defs/profileLock"},
        "qualification_status": {"const": "unqualified"}
      }
    }
  }
}
